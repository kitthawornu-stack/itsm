{
  "rules": {
    "color-no-invalid-hex": true,
    "color-named": "never",
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-color|border|border-color|border-top|border-right|border-bottom|border-left|outline|fill|stroke|box-shadow)$/": [
        "/#[0-9a-fA-F]{3,8}/",
        "/(rgb|rgba|hsl|hsla)\\(/"
      ]
    }
  },
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**"
  ],
  "overrides": [
    {
      "files": [
        "packages/ui/src/styles/tokens.css"
      ],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
