    "prisma:generate": "dotenv -e ../../.env -- prisma generate"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "dotenv-cli": "^7.4.4"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@itsm/types": "workspace:*"
  },
  "type": "module"
}
