# ---------- Database (MySQL 8) ----------
MYSQL_ROOT_PASSWORD=itsm_root_dev
MYSQL_DATABASE=itsm
MYSQL_USER=itsm
MYSQL_PASSWORD=itsm_dev
MYSQL_PORT=3307  # 3306 ถูกใช้โดย MySQL80 ของเครื่อง
DATABASE_URL="mysql://itsm:itsm_dev@localhost:3307/itsm"

# ---------- Redis / BullMQ ----------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ---------- OpenSearch ----------
OPENSEARCH_PORT=9200
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_INDEX_PREFIX=itsm

# ---------- Object storage (MinIO, S3-compatible) ----------
MINIO_ROOT_USER=itsm
MINIO_ROOT_PASSWORD=itsm_dev_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET=itsm-attachments
S3_REGION=ap-southeast-1

# ---------- Mail (Mailpit in dev, catches everything) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Helix Service Desk <no-reply@itsm.local>"

# ---------- App ----------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL="http://localhost:4000"
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# ---------- Tenancy ----------
# on-prem = single tenant; SaaS = เปิด multi-tenant ใน Phase 5
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_KEY=default

# ---------- Localisation ----------
DEFAULT_LOCALE=th
DEFAULT_TIMEZONE=Asia/Bangkok
