// Helix — ITSM + Project Management Platform
// ตารางแกน 27 ตาราง สำหรับ Phase 0
// กติกาบังคับ (ดู CLAUDE.md §1):
//   1. ทุกตารางมี tenantId และเป็นคอลัมน์แรกของทุก composite index
//   2. เวลาทุกค่าเป็น DATETIME(3) UTC — ห้ามใช้ TIMESTAMP (จำกัดถึงปี 2038)
//   3. MySQL ไม่มี partial index / array type — ใช้ bridge table ไม่ใช่ JSON ที่ query ไม่ลง index
//   4. work_item.rank ต้องใช้ collation utf8mb4_bin (ตั้งใน migration แยก — Prisma ยังไม่รองรับ per-column collation)

generator client {
  provider = "prisma-client-js"
  // ไม่ตั้ง output — ปล่อยให้ลงที่ node_modules/.prisma/client ข้าง @prisma/client
  // ถ้าตั้ง output เอง runtime ของ @prisma/client จะหาไฟล์ไม่เจอใน pnpm workspace
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM
// ============================================================

model Tenant {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(64) // ใช้ใน subdomain และ index alias ของ OpenSearch
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  locale    String   @default("th") @db.VarChar(10)
  timezone  String   @default("Asia/Bangkok") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users             User[]
  groups            UserGroup[]
  projects          Project[]
  issueTypes        IssueType[]
  priorities        Priority[]
  resolutions       Resolution[]
  workflows         Workflow[]
  fieldDefinitions  FieldDefinition[]
  workItems         WorkItem[]
  permissionSchemes PermissionScheme[]
  auditLogs         AuditLog[]
  savedFilters      SavedFilter[]
  knowledgeArticles KnowledgeArticle[]
  catalogItems      CatalogItem[]
  satisfactions     Satisfaction[]
  approvals         Approval[]
  catalogCategories CatalogCategory[]
  automationRules   AutomationRule[]
  automationRuns    AutomationRun[]
  workLogs          WorkLog[]
  inboundMails      InboundMail[]
  notificationRules NotificationRule[]
  notificationPrefs NotificationPreference[]
  notifications     Notification[]
  changeWindows     ChangeWindow[]
  changeFreezes     ChangeFreeze[]
  configItems       ConfigurationItem[]
  ciDependencies    CiDependency[]

  @@map("tenant")
}

model User {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @map("tenant_id")
  email        String    @db.VarChar(320)
  displayName  String    @map("display_name") @db.VarChar(255)
  avatarColor  String?   @map("avatar_color") @db.VarChar(7) // เก็บเป็น token key ไม่ใช่สีดิบ ดู CLAUDE.md §6
  passwordHash String?   @map("password_hash") @db.VarChar(255) // null เมื่อผู้ใช้มาจาก SSO/LDAP เท่านั้น
  externalId   String?   @map("external_id") @db.VarChar(255) // subject จาก OIDC / DN จาก LDAP
  isSystem     Boolean   @default(false) @map("is_system") // true สำหรับ actor ของ Automation ดู CLAUDE.md
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupMemberships        GroupMember[]
  reportedItems           WorkItem[]               @relation("WorkItemReporter")
  assignedItems           WorkItem[]               @relation("WorkItemAssignee")
  comments                WorkItemComment[]
  attachments             WorkItemAttachment[]
  watching                WorkItemWatcher[]
  historyEntries          WorkItemHistory[]
  auditLogs               AuditLog[]
  sessions                Session[]
  loginAttempts           LoginAttempt[]
  verifiedCalendarYears   SlaCalendarYear[]        @relation("CalendarVerifier")
  savedFilters            SavedFilter[]
  articles                KnowledgeArticle[]
  articleLinks            WorkItemArticle[]
  satisfactions           Satisfaction[]
  approvalsRequested      Approval[]               @relation("ApprovalRequester")
  approvalsDecided        Approval[]               @relation("ApprovalDecider")
  automationRules         AutomationRule[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  changeWindows           ChangeWindow[]
  workLogs                WorkLog[]

  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([tenantId, externalId])
  @@map("user")
}

/**
 * เซสชันฝั่งเซิร์ฟเวอร์ — ADR-003 เลือกสิ่งนี้แทน JWT
 * JWT เพิกถอนไม่ได้ถ้าไม่มีบัญชีดำ ซึ่งเท่ากับมีตารางเซสชันอยู่ดี แต่ซับซ้อนกว่า
 * และตอบไม่ได้ว่า "ตอนนี้ใครล็อกอินอยู่บ้าง" ซึ่งเป็นคำถามที่ผู้ดูแลระบบถามจริง
 * **เก็บเฉพาะแฮชของโทเคน ไม่เก็บตัวโทเคน** — ฐานข้อมูลที่รั่วต้องไม่ทำให้
 * ผู้อ่านสวมรอยเป็นใครได้ทันที เหมือนที่ไม่เก็บรหัสผ่านเป็นข้อความล้วน
 */
model Session {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  userId   BigInt @map("user_id")

  /// SHA-256 ของโทเคนที่ส่งให้ผู้ใช้ — ตัวโทเคนจริงไม่เคยถูกเก็บ
  tokenHash String @map("token_hash") @db.VarChar(64)

  /// บริบทตอนสร้าง เอาไว้ให้เจ้าของบัญชีดูว่ามีเซสชันแปลกปลอมหรือไม่
  userAgent String? @map("user_agent") @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(45)

  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  /// เวลาที่ถูกเพิกถอน — null คือยังใช้ได้
  /// เก็บเป็นเวลา ไม่ใช่ boolean เพราะต้องตอบได้ว่าถูกตัดตอนไหน
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

/**
 * บันทึกการพยายามล็อกอิน — ใช้จำกัดจำนวนครั้งที่เดารหัสผ่าน
 * เก็บทั้งที่สำเร็จและล้มเหลว เพราะการนับเฉพาะที่ล้มเหลวทำให้ผู้โจมตี
 * ที่เดาถูกหนึ่งครั้งกลางทาง ล้างประวัติของตัวเองได้
 * `identifier` คืออีเมลที่กรอกมา **ไม่ใช่ userId** เพราะต้องนับการเดาบัญชี
 * ที่ไม่มีอยู่จริงด้วย ไม่งั้นการยิงสุ่มอีเมลจะไม่ถูกจำกัดเลย
 */
model LoginAttempt {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  identifier String   @db.VarChar(320)
  userId     BigInt?  @map("user_id")
  succeeded  Boolean
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, identifier, createdAt])
  @@map("login_attempt")
}

model UserGroup {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(255)
  isSynced  Boolean  @default(false) @map("is_synced") // มาจาก LDAP/AD sync — ห้ามแก้สมาชิกด้วยมือ
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members        GroupMember[]
  grants         PermissionGrant[]
  notifyProjects Project[]         @relation("ProjectNotifyGroup")
  approvals      Approval[]
  ownedCis       ConfigurationItem[]

  @@unique([tenantId, name])
  @@map("user_group")
}

model GroupMember {
  groupId  BigInt   @map("group_id")
  userId   BigInt   @map("user_id")
  tenantId BigInt   @map("tenant_id")
  addedAt  DateTime @default(now()) @map("added_at") @db.DateTime(3)

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([tenantId, userId])
  @@map("group_member")
}

model PermissionScheme {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grants   PermissionGrant[]
  projects Project[]

  @@unique([tenantId, name])
  @@map("permission_scheme")
}

// สิทธิ์ให้กับ "กลุ่ม" หรือ "บทบาทในโปรเจกต์" — ไม่ให้กับผู้ใช้รายบุคคลโดยตรง
// เพื่อให้ audit ตอบได้ว่าทำไมคนนี้ทำได้ ไม่ใช่แค่ว่าทำได้
model PermissionGrant {
  id          BigInt        @id @default(autoincrement())
  tenantId    BigInt        @map("tenant_id")
  schemeId    BigInt        @map("scheme_id")
  permission  PermissionKey
  groupId     BigInt?       @map("group_id")
  projectRole ProjectRole?  @map("project_role")

  scheme PermissionScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  group  UserGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([schemeId, permission, groupId, projectRole])
  @@index([tenantId, permission])
  @@map("permission_grant")
}

enum PermissionKey {
  BROWSE_PROJECT
  CREATE_ITEM
  EDIT_ITEM
  DELETE_ITEM
  ASSIGN_ITEM
  TRANSITION_ITEM
  ADD_COMMENT
  DELETE_COMMENT
  /// เห็นบันทึกภายในของทีม — แยกจาก ADD_COMMENT โดยตั้งใจ
  /// ผู้แจ้งต้องเขียนความเห็นได้ แต่ต้องไม่เห็นสิ่งที่ทีมคุยกันเอง
  VIEW_INTERNAL_COMMENT
  MANAGE_ATTACHMENT
  LINK_ITEM
  BULK_EDIT
  MANAGE_SPRINT
  MANAGE_PROJECT
  VIEW_REPORT
  ADMINISTER_TENANT
}

enum ProjectRole {
  AGENT
  CUSTOMER
  DEVELOPER
  MANAGER
  ADMIN
}

// append-only — ห้าม UPDATE หรือ DELETE (บังคับที่ชั้น service ดู CLAUDE.md §1 invariant 2)
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(64) // e.g. "permission.grant", "user.deactivate"
  /// ชื่อผู้ทำ ณ ตอนที่ทำ — เก็บซ้ำโดยตั้งใจ
  ///
  /// `actorId` เป็น SetNull เมื่อผู้ใช้ถูกลบ ร่องรอยจึงกลายเป็น "ไม่มี actor"
  /// ซึ่งแยกจาก "ระบบทำเอง" ไม่ได้ · audit ที่ลืมว่าใครทำ ไม่ใช่ audit
  actorName  String?  @map("actor_name") @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  payload    Json?
  traceId    String?  @map("trace_id") @db.VarChar(64) // โยงกลับไป OpenTelemetry trace ได้
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_log")
}

// ============================================================
// CONFIGURATION
// ============================================================

model Project {
  id                 BigInt      @id @default(autoincrement())
  tenantId           BigInt      @map("tenant_id")
  key                String      @db.VarChar(16) // คำนำหน้าของ item_key เช่น "SD", "PLAT"
  name               String      @db.VarChar(255)
  description        String?     @db.Text
  type               ProjectType
  leadId             BigInt?     @map("lead_id")
  /// กลุ่มที่รับการแจ้งเตือนของงานที่ยังไม่มีผู้รับผิดชอบ
  /// null = ไม่มีปลายทาง การแจ้งเตือนระดับทีมของโปรเจกต์นี้จะไปไม่ถึงใคร
  /// ซึ่งบันทึกไว้เป็น skipped พร้อมเหตุผล ไม่ใช่หายเงียบ
  notifyGroupId      BigInt?     @map("notify_group_id")
  permissionSchemeId BigInt?     @map("permission_scheme_id")
  isArchived         Boolean     @default(false) @map("is_archived")
  createdAt          DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissionScheme  PermissionScheme?  @relation(fields: [permissionSchemeId], references: [id], onDelete: SetNull)
  notifyGroup       UserGroup?         @relation("ProjectNotifyGroup", fields: [notifyGroupId], references: [id], onDelete: SetNull)
  counter           ProjectCounter?
  slaPolicies       SlaPolicy[]
  workItems         WorkItem[]
  catalogItems      CatalogItem[]
  workflowSchemes   WorkflowScheme[]
  fieldConfigs      FieldConfig[]
  automationRules   AutomationRule[]
  notificationRules NotificationRule[]

  @@unique([tenantId, key])
  @@index([tenantId, isArchived])
  @@map("project")
}

enum ProjectType {
  SERVICE_DESK
  SOFTWARE
  BUSINESS
}

// ตัวนับเลขรันแยกต่อโปรเจกต์ — ค่าจริงมาจาก Redis INCR, ตารางนี้เป็นแหล่งความจริงสำรอง
// และเป็นค่าเริ่มต้นตอน warm cache ใหม่
model ProjectCounter {
  projectId BigInt   @id @map("project_id")
  tenantId  BigInt   @map("tenant_id")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_counter")
}

model IssueType {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  name           String   @db.VarChar(64)
  iconKey        String   @map("icon_key") @db.VarChar(32) // ชื่อไอคอนใน design system ไม่ใช่ URL
  isSubtask      Boolean  @default(false) @map("is_subtask")
  hierarchyLevel Int      @default(0) @map("hierarchy_level") // 1=Epic, 0=Story/Task/Incident, -1=Sub-task
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems       WorkItem[]
  workflowSchemes WorkflowScheme[]
  fieldConfigs    FieldConfig[]
  catalogItems    CatalogItem[]

  @@unique([tenantId, name])
  @@map("issue_type")
}

model Priority {
  id         Int      @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  name       String   @db.VarChar(32)
  rank       Int // 1 = P1 Critical ... 5 = P5 Trivial — ใช้เรียงลำดับ
  colorToken String   @map("color_token") @db.VarChar(32) // semantic token key เช่น "status-critical" ไม่ใช่ hex
  /// เลิกใช้แล้ว = ไม่ให้เลือกใหม่ แต่ยังแสดงบนงานเก่าที่ถืออยู่
  /// ไม่มีการลบ เพราะ onDelete: SetNull จะล้างค่าบนงานที่ปิดไปแล้วทุกใบเงียบ ๆ
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems    WorkItem[]
  catalogItems CatalogItem[]

  @@unique([tenantId, name])
  @@index([tenantId, rank])
  @@map("priority")
}

model Resolution {
  id        Int      @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(64)
  position  Int      @default(0) // ลำดับที่แสดงในตัวเลือกตอนปิดงาน
  /// เลิกใช้แล้ว = ไม่ให้เลือกใหม่ แต่ยังแสดงบนงานเก่าที่ถืออยู่ (ดู Priority)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([tenantId, name])
  @@map("resolution")
}

// ============================================================
// WORKFLOW ENGINE
// ============================================================

model Workflow {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(255)
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]
  schemes     WorkflowScheme[]

  @@unique([tenantId, name, version])
  @@map("workflow")
}

// category คือสิ่งที่ Board, Burndown และ SLA ใช้ — ไม่ใช่ชื่อสถานะ
model WorkflowStatus {
  id         BigInt         @id @default(autoincrement())
  tenantId   BigInt         @map("tenant_id")
  workflowId BigInt         @map("workflow_id")
  name       String         @db.VarChar(64)
  category   StatusCategory
  position   Int
  isInitial  Boolean        @default(false) @map("is_initial")
  pausesSla  Boolean        @default(false) @map("pauses_sla") // เช่น "Pending Customer" — หยุดนาฬิกา SLA

  workflow        Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")
  workItems       WorkItem[]

  @@unique([workflowId, name])
  @@index([tenantId, workflowId, position])
  @@map("workflow_status")
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

model WorkflowTransition {
  id           BigInt  @id @default(autoincrement())
  tenantId     BigInt  @map("tenant_id")
  workflowId   BigInt  @map("workflow_id")
  name         String  @db.VarChar(64) // ข้อความบนปุ่ม — ภาษาคน ดู CLAUDE.md §5
  fromStatusId BigInt? @map("from_status_id") // null = transition ที่ทำได้จากทุกสถานะ (global)
  toStatusId   BigInt  @map("to_status_id")
  position     Int     @default(0) // ลำดับของคีย์ลัด 1-9 ในหน้ารายละเอียด

  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus?  @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus   @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  rules      TransitionRule[]

  @@index([tenantId, workflowId, fromStatusId])
  @@map("workflow_transition")
}

// สามชั้นของ transition: CONDITION (ใครเห็นปุ่ม) → VALIDATOR (กรอกครบไหม) → POST_FUNCTION (ทำอะไรต่อ)
model TransitionRule {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @map("tenant_id")
  transitionId BigInt   @map("transition_id")
  kind         RuleKind
  ruleType     String   @map("rule_type") @db.VarChar(64) // e.g. "assignee-is-current-user", "required-fields", "set-resolution"
  config       Json
  position     Int      @default(0)

  transition WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, transitionId, kind, position])
  @@map("transition_rule")
}

enum RuleKind {
  CONDITION
  VALIDATOR
  POST_FUNCTION
}

// ผูก (project × issueType) → workflow — นี่คือกลไกที่ทำให้ Incident กับ Story
// อยู่ตาราง work_item เดียวกันได้โดยมีพฤติกรรมคนละแบบ
model WorkflowScheme {
  id          BigInt @id @default(autoincrement())
  tenantId    BigInt @map("tenant_id")
  projectId   BigInt @map("project_id")
  issueTypeId BigInt @map("issue_type_id")
  workflowId  BigInt @map("workflow_id")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueType IssueType @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@unique([projectId, issueTypeId])
  @@index([tenantId, workflowId])
  @@map("workflow_scheme")
}

// ============================================================
// CUSTOM FIELD (ADR-001: EAV + JSON snapshot)
// ============================================================

model FieldDefinition {
  id        BigInt    @id @default(autoincrement())
  tenantId  BigInt    @map("tenant_id")
  key       String    @db.VarChar(64)
  name      String    @db.VarChar(255)
  type      FieldType
  options   Json? // ตัวเลือกของ SELECT/MULTI_SELECT — อ่านอย่างเดียว ไม่ใช้ query
  isSystem  Boolean   @default(false) @map("is_system") // ฟิลด์ระบบ เช่น summary, priority — ห้ามลบ
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configs FieldConfig[]
  values  WorkItemFieldValue[]

  @@unique([tenantId, key])
  @@map("field_definition")
}

enum FieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  DECIMAL
  DATE
  DATETIME
  CHECKBOX
  SELECT
  MULTI_SELECT
  USER
  MULTI_USER
  LABELS
  URL
}

// ฟิลด์ตัวไหนแสดง/บังคับกรอก ในโปรเจกต์และประเภทงานไหน
model FieldConfig {
  id          BigInt  @id @default(autoincrement())
  tenantId    BigInt  @map("tenant_id")
  projectId   BigInt  @map("project_id")
  issueTypeId BigInt  @map("issue_type_id")
  fieldId     BigInt  @map("field_id")
  isRequired  Boolean @default(false) @map("is_required")
  isVisible   Boolean @default(true) @map("is_visible")
  position    Int     @default(0)

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueType IssueType       @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)
  field     FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueTypeId, fieldId])
  @@index([tenantId, projectId, issueTypeId, position])
  @@map("field_config")
}

// ============================================================
// CORE WORK ITEM
// ============================================================

model WorkItem {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  itemKey     String @map("item_key") @db.VarChar(32) // "SD-1042" — คีย์ที่มนุษย์อ่าน
  projectId   BigInt @map("project_id")
  issueTypeId BigInt @map("issue_type_id")

  summary     String @db.VarChar(500)
  description Json? // rich text เป็น structured document ไม่ใช่ HTML ดิบ

  statusId     BigInt @map("status_id")
  priorityId   Int?   @map("priority_id")
  resolutionId Int?   @map("resolution_id")

  reporterId    BigInt  @map("reporter_id")
  assigneeId    BigInt? @map("assignee_id")
  parentId      BigInt? @map("parent_id")
  /// แจ้งผ่านรายการบริการไหน — null = พิมพ์อิสระ (ยังต้องมีทางนี้เสมอ)
  /// เก็บตั้งแต่วันแรก เพราะย้อนกลับไปเติมให้เรื่องเก่าไม่ได้
  catalogItemId BigInt? @map("catalog_item_id")

  // LexoRank (ADR-002) — สตริงเรียงลำดับได้ ทำให้ลากการ์ดเป็น UPDATE แถวเดียว
  // ต้องใช้ collation utf8mb4_bin — ตั้งใน migration แยก
  rank String @db.VarChar(255)

  storyPoints   Decimal? @map("story_points") @db.Decimal(6, 2)
  timeOriginal  Int?     @map("time_original") // วินาที
  timeSpent     Int?     @map("time_spent") // วินาที
  timeRemaining Int?     @map("time_remaining") // วินาที

  dueDate DateTime? @map("due_date") @db.DateTime(3)

  // สำเนาอ่านอย่างเดียวของ custom field — ห้ามอ่านไปเขียนต่อ (CLAUDE.md §3)
  fieldSnapshot Json? @map("field_snapshot")
  // สถานะนาฬิกา SLA ที่ denormalize ไว้ เพื่อให้คิวเรนเดอร์แถบเวลาได้โดยไม่ JOIN
  slaState      Json? @map("sla_state")

  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  resolvedAt DateTime? @map("resolved_at") @db.DateTime(3) // ฐานของ MTTR ทุกรายงาน

  /// เวลาที่ประมาณไว้ตอนแรก (นาที) — `null` = ไม่มีใครประมาณ ต่างจาก 0
  originalEstimateMinutes Int? @map("original_estimate_minutes")
  /// เวลาที่เหลือ (นาที) — **ไม่ใช่ original ลบ spent**
  ///
  /// งานที่ประมาณไว้ 4 ชั่วโมงแล้วใช้ไป 5 ชั่วโมง อาจยังเหลืออีก 2 ชั่วโมงจริง
  /// การคำนวณด้วยการลบจะได้ค่าติดลบ ซึ่งตอบคำถามที่ไม่มีใครถามและทำให้
  /// ยอดรวมของทั้งโปรเจกต์ผิด (บทเรียนเดียวกับ breachAt กับ breachedAt)
  remainingMinutes        Int? @map("remaining_minutes")
  /// ยอดรวมของ work_log — เก็บซ้ำเพื่อไม่ต้อง SUM ทุกครั้งที่เรนเดอร์ลิสต์
  ///
  /// แหล่งความจริงคือ `work_log` · ค่านี้คำนวณใหม่ได้เสมอจากที่นั่น
  spentMinutes            Int  @default(0) @map("spent_minutes")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  issueType    IssueType      @relation(fields: [issueTypeId], references: [id], onDelete: Restrict)
  status       WorkflowStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priority     Priority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  catalogItem  CatalogItem?   @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  satisfaction Satisfaction?
  approvals    Approval[]
  resolution   Resolution?    @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  reporter     User           @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee     User?          @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent       WorkItem?      @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     WorkItem[]     @relation("WorkItemHierarchy")

  slaClocks      WorkItemSla[]
  fieldValues    WorkItemFieldValue[]
  comments       WorkItemComment[]
  attachments    WorkItemAttachment[]
  watchers       WorkItemWatcher[]
  history        WorkItemHistory[]
  keyAliases     WorkItemKeyAlias[]
  linksOut       WorkItemLink[]       @relation("LinkSource")
  linksIn        WorkItemLink[]       @relation("LinkTarget")
  articles       WorkItemArticle[]
  automationRuns AutomationRun[]
  workLogs       WorkLog[]
  inboundMails   InboundMail[]
  notifications  Notification[]
  changeWindow   ChangeWindow?

  @@unique([tenantId, itemKey])
  @@index([tenantId, projectId, statusId])
  @@index([tenantId, assigneeId, statusId])
  @@index([tenantId, projectId, rank])
  @@index([tenantId, parentId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, resolvedAt])
  // คิวรีของหน้า Agent Queue: งานที่เปิดอยู่ของโปรเจกต์ เรียงตามอัปเดตล่าสุด
  // EXPLAIN บนข้อมูลจริง 10,000 แถวชี้ว่า index สองตัวบนนี้ให้ filtered เพียง 7%
  // (สแกน 5,000 แถวเพื่อคืน 50) — index นี้ครอบทั้ง predicate และ ORDER BY
  @@index([tenantId, projectId, resolvedAt, updatedAt])
  @@map("work_item")
}

// คีย์เดิมหลังย้ายงานข้ามโปรเจกต์ — เก็บไว้ตลอดไปเพื่อให้ลิงก์เก่าและอีเมลเก่ายังใช้ได้
model WorkItemKeyAlias {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  oldKey     String   @map("old_key") @db.VarChar(32)
  workItemId BigInt   @map("work_item_id")
  movedAt    DateTime @default(now()) @map("moved_at") @db.DateTime(3)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, oldKey])
  @@index([tenantId, workItemId])
  @@map("work_item_key_alias")
}

// แหล่งความจริงของ custom field — แยกคอลัมน์ตามชนิดเพื่อให้ index และเปรียบเทียบได้ถูกชนิด
model WorkItemFieldValue {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  workItemId BigInt @map("work_item_id")
  fieldId    BigInt @map("field_id")

  valueText   String?   @map("value_text") @db.Text
  valueNumber Decimal?  @map("value_number") @db.Decimal(20, 6)
  valueDate   DateTime? @map("value_date") @db.DateTime(3)
  valueBool   Boolean?  @map("value_bool")
  valueRefId  BigInt?   @map("value_ref_id") // อ้างถึง user / option id

  // ลำดับของค่าในฟิลด์หลายค่า (multi-select, labels, multi-user) — ค่าเดี่ยวใช้ 0
  //
  // Spike B พบว่า unique เดิม (workItemId, fieldId, valueRefId) ใช้ไม่ได้:
  // ฟิลด์หลายค่าที่เก็บเป็นข้อความมี valueRefId = NULL ทุกแถว จึงชนกันเอง
  // และไม่มีทางรักษาลำดับที่ผู้ใช้เลือกไว้
  position Int @default(0)

  workItem WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([workItemId, fieldId, position])
  @@index([tenantId, fieldId, valueNumber])
  @@index([tenantId, fieldId, valueDate])
  @@index([tenantId, fieldId, valueRefId])
  @@map("work_item_field_value")
}

model WorkItemLink {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  sourceId  BigInt   @map("source_id")
  targetId  BigInt   @map("target_id")
  type      LinkType
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  source WorkItem @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target WorkItem @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([tenantId, targetId])
  @@map("work_item_link")
}

enum LinkType {
  RELATES_TO
  BLOCKS
  IS_BLOCKED_BY
  DUPLICATES
  CAUSES
  IS_CAUSED_BY
}

model WorkItemComment {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt    @map("tenant_id")
  workItemId BigInt    @map("work_item_id")
  authorId   BigInt    @map("author_id")
  body       Json // structured document — sanitize ที่ชั้น service
  isInternal Boolean   @default(false) @map("is_internal") // true = ไม่แสดงใน Service Portal
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3) // soft delete — audit ต้องยังตอบได้ว่าเคยมี
  /// เวลาที่ถูกแก้ไข — null คือยังไม่เคยแก้
  ///
  /// แยกจาก updatedAt ซึ่ง Prisma ตั้งให้ทุกครั้งที่แถวถูกเขียน รวมทั้งตอนลบ
  /// ถ้าใช้ updatedAt เป็นตัวบอกว่า "แก้แล้ว" ความเห็นที่ถูกลบจะแสดงว่าเคยถูกแก้ด้วย
  editedAt   DateTime? @map("edited_at") @db.DateTime(3)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, workItemId, createdAt])
  @@map("work_item_comment")
}

model WorkItemAttachment {
  id         BigInt     @id @default(autoincrement())
  tenantId   BigInt     @map("tenant_id")
  workItemId BigInt     @map("work_item_id")
  uploaderId BigInt     @map("uploader_id")
  filename   String     @db.VarChar(500)
  mimeType   String     @map("mime_type") @db.VarChar(255)
  sizeBytes  BigInt     @map("size_bytes")
  storageKey String     @map("storage_key") @db.VarChar(1000) // path ใน MinIO/S3
  scanStatus ScanStatus @default(PENDING) @map("scan_status")
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([tenantId, workItemId])
  @@map("work_item_attachment")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

model WorkItemWatcher {
  workItemId BigInt   @map("work_item_id")
  userId     BigInt   @map("user_id")
  tenantId   BigInt   @map("tenant_id")
  addedAt    DateTime @default(now()) @map("added_at") @db.DateTime(3)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
  @@index([tenantId, userId])
  @@map("work_item_watcher")
}

// append-only — เขียนในทรานแซกชันเดียวกับการแก้ข้อมูล (CLAUDE.md §1 invariant 2)
model WorkItemHistory {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  workItemId BigInt   @map("work_item_id")
  actorId    BigInt?  @map("actor_id") // null = ระบบ · ดู isSystem บน user สำหรับ Automation
  field      String   @db.VarChar(64) // "status", "assignee", "customfield_12" หรือ "__transition__"
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  traceId    String?  @map("trace_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, workItemId, createdAt])
  @@index([tenantId, field, createdAt])
  @@map("work_item_history")
}

// ============================================================
// SLA
// ============================================================

/**
 * ปฏิทินเวลาทำการ — แอดมินตั้งค่าได้ ไม่ใช่เขียนตายในโค้ด
 * `verified` เป็น false จนกว่าจะมีคนตรวจรายการวันหยุดกับประกาศจริง
 * ระบบต้องปฏิเสธการคำนวณ SLA บน production ด้วยปฏิทินที่ยังไม่ตรวจสอบ
 */
/// คิวรีที่ตั้งชื่อไว้ใช้ซ้ำ
///
/// `hql` เก็บเป็น **ข้อความที่ผู้ใช้พิมพ์** ไม่ใช่ DSL ที่แปลแล้ว
/// เพราะ DSL ที่แปลไว้จะค้างอยู่กับกติกาของวันที่บันทึก — เพิ่มฟิลด์ใหม่
/// หรือแก้เกณฑ์การค้นหาเมื่อไร ตัวกรองเก่าจะยังใช้ของเดิมโดยไม่มีใครรู้
model SavedFilter {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  ownerId   BigInt   @map("owner_id")
  name      String   @db.VarChar(128)
  hql       String   @db.Text
  /// แชร์ให้ทุกคนในองค์กรเห็น — แต่ **ทำงานด้วยขอบเขตของคนที่กด ไม่ใช่ของเจ้าของ**
  isShared  Boolean  @default(false) @map("is_shared")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([tenantId, isShared, name])
  @@map("saved_filter")
}

model SlaCalendar {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(255)
  timezone  String   @default("Asia/Bangkok") @db.VarChar(64)
  /// เวลาทำการรายวัน [{startMinute,endMinute}] × 7 · index 0 = อาทิตย์
  weekly    Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  holidays SlaHoliday[]
  policies SlaPolicy[]
  years    SlaCalendarYear[]

  @@unique([tenantId, name])
  @@map("sla_calendar")
}

/// การยืนยันว่ารายการวันหยุด **ของปีหนึ่ง** ตรงกับประกาศจริง
///
/// เดิมเป็นบูลีนตัวเดียวบน `sla_calendar` ซึ่งถูกไม่ได้เกินหนึ่งปี —
/// วันหยุดเปลี่ยนทุกปี การยืนยันปี 2569 ไม่ได้บอกอะไรเลยเกี่ยวกับปี 2570
///
/// **การมีแถวนี้อยู่ = ยืนยันแล้ว** ไม่มีคอลัมน์ `verified` ให้ตั้งเป็น true ลอย ๆ
/// และทุกแถวต้องตอบได้ว่าใครยืนยัน เมื่อไร เทียบกับประกาศฉบับไหน
model SlaCalendarYear {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @map("tenant_id")
  calendarId   BigInt   @map("calendar_id")
  year         Int
  verifiedAt   DateTime @map("verified_at") @db.DateTime(3)
  verifiedById BigInt?  @map("verified_by_id")
  /// ประกาศที่ใช้ตรวจ เช่น "มติ ครม. 4 พ.ย. 2568" — ว่างไม่ได้
  source       String   @db.VarChar(255)

  calendar   SlaCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  verifiedBy User?       @relation("CalendarVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([calendarId, year])
  @@map("sla_calendar_year")
}

model SlaHoliday {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  calendarId BigInt @map("calendar_id")
  /// YYYY-MM-DD ตามเวลาท้องถิ่นของปฏิทิน — เก็บเป็นข้อความเพื่อไม่ให้ timezone เข้ามาเกี่ยว
  date       String @db.VarChar(10)
  name       String @db.VarChar(255)

  calendar SlaCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([tenantId, date])
  @@map("sla_holiday")
}

model SlaPolicy {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  projectId  BigInt   @map("project_id")
  name       String   @db.VarChar(255)
  calendarId BigInt   @map("calendar_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  calendar SlaCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  goals    SlaGoal[]

  @@unique([tenantId, projectId, name])
  @@map("sla_policy")
}

/**
 * เป้าหมายหนึ่งข้อ เช่น "ตอบกลับครั้งแรกภายใน 15 นาทีสำหรับ P1"
 * ระบบไล่ goal จาก position น้อยไปมาก และใช้ **ตัวแรกที่เข้าเงื่อนไข**
 * เงื่อนไขตอนนี้เป็นโครงสร้างง่าย ๆ (ช่วงความสำคัญ + ประเภทงาน)
 * แผนระบุว่าจะใช้ HQL — ยังไม่ถึงเวลา เพราะ HQL compiler ยิงไป OpenSearch
 * ซึ่งใช้ตัดสินเงื่อนไขของแถวเดียวไม่ได้
 */
model SlaGoal {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  policyId BigInt @map("policy_id")
  /// คีย์ที่โค้ดอ้างถึง เช่น "time-to-resolve"
  key      String @db.VarChar(64)
  name     String @db.VarChar(255)
  /// เป้าหมายเป็นมิลลิวินาทีของเวลาทำการ
  targetMs Int    @map("target_ms")
  position Int    @default(0)
  /// เงื่อนไขการเข้าคู่ {priorityRanks?: number[], issueTypeNames?: string[]}
  match    Json?

  policy SlaPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  items  WorkItemSla[]

  @@unique([policyId, key, position])
  @@index([tenantId, policyId, position])
  @@map("sla_goal")
}

/**
 * นาฬิกา SLA หนึ่งเรือนของงานหนึ่งใบ
 * คอลัมน์สถานะเป็นค่า denormalise จากรายการเหตุการณ์ — **แหล่งความจริงคือ
 * `sla_event`** คำนวณใหม่จากเหตุการณ์ได้เสมอ ซึ่งจำเป็นเมื่อต้องแก้ปฏิทิน
 * ย้อนหลังหรือแก้เป้าที่ตั้งผิด
 */
/// ชนิดของสิ่งที่ดูแล — หยาบพอที่คนกรอกได้เร็ว ละเอียดพอที่กรองมีความหมาย
enum CiKind {
  SERVICE
  APPLICATION
  SERVER
  DATABASE
  NETWORK
  OTHER
}

enum CiStatus {
  PLANNED
  ACTIVE
  RETIRED
}

/// สิ่งที่ทีมไอทีดูแล — เครื่อง ระบบ บริการ
///
/// **มีเพื่อตอบคำถามเดียว: "ถ้าตัวนี้ล่ม อะไรพังตามบ้าง"** · CMDB ที่เก็บทุก
/// รายละเอียดของทุกเครื่องกลายเป็นทะเบียนที่ไม่มีใครอัปเดต · ที่นี่จึงเก็บ
/// เท่าที่ตอบคำถามนั้นได้ แล้วให้รายละเอียดอื่นอยู่ในที่ที่มันอยู่แล้ว
model ConfigurationItem {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  /// รหัสสั้นที่คนพูดถึงกันได้ เช่น `DB-PROD-01`
  key  String   @db.VarChar(64)
  name String   @db.VarChar(255)
  kind CiKind
  /// `PLANNED` = ยังไม่ขึ้นใช้จริง · `RETIRED` = เลิกใช้แล้วแต่เก็บประวัติไว้
  status CiStatus @default(ACTIVE)

  /// ทีมที่ดูแล — ปลายทางของการแจ้งเมื่อมีเรื่องกระทบตัวนี้
  ownerGroupId BigInt? @map("owner_group_id")
  notes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerGroup UserGroup? @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)

  dependsOn CiDependency[] @relation("CiDependent")
  usedBy    CiDependency[] @relation("CiDependsOn")

  @@unique([tenantId, key])
  @@index([tenantId, kind, status])
  @@map("configuration_item")
}

/// "ตัวที่พึ่งพา" พึ่ง "ตัวที่ถูกพึ่งพา" — ตัวหลังล่ม ตัวแรกพัง
///
/// **เก็บทิศเดียว** เหมือน `work_item_link` · คำถามผลกระทบไล่กลับทิศตอนอ่าน
/// การเก็บสองแถวจะทำให้วันหนึ่งมีคนลบไปข้างเดียว แล้วกราฟตอบสองอย่างขัดกัน
model CiDependency {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  dependentId BigInt @map("dependent_id")
  dependsOnId BigInt @map("depends_on_id")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dependent ConfigurationItem @relation("CiDependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependsOn ConfigurationItem @relation("CiDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([dependentId, dependsOnId])
  @@index([tenantId, dependsOnId])
  @@map("ci_dependency")
}

/// หน้าต่างเวลาดำเนินการของการเปลี่ยนแปลงหนึ่งใบ
///
/// เป็นตารางบริวารของ `work_item` แบบเดียวกับ `work_item_sla` — ไม่ใช่คอลัมน์
/// ใน `work_item` เพราะงานส่วนใหญ่ไม่มีหน้าต่างเวลา และไม่ใช่ custom field
/// เพราะการหาว่า "ช่วงนี้ชนกับใครบ้าง" ต้องเป็นคิวรีช่วงเวลาที่ลง index ได้
model ChangeWindow {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  workItemId BigInt @unique @map("work_item_id")

  /// ช่วงเวลาแบบ [start, end) — ปลายของอันหนึ่งชนต้นของอีกอันพอดี ไม่ถือว่าชน
  plannedStart DateTime @map("planned_start") @db.DateTime(3)
  plannedEnd   DateTime @map("planned_end") @db.DateTime(3)

  /// เหตุผลที่ขอข้ามช่วงห้ามเปลี่ยนแปลง — null เมื่อไม่ได้ข้ามอะไร
  ///
  /// เก็บข้อความ ไม่ใช่ boolean · "ข้ามแล้ว" ที่ตอบไม่ได้ว่าทำไม
  /// คือความเงียบที่ไม่มีใครสืบต่อได้ (บทเรียนเดียวกับ notification_delivery)
  freezeOverrideReason String? @map("freeze_override_reason") @db.VarChar(500)

  createdById BigInt   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem  WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  /// คิวรีหาการชนกันวิ่งด้วย (องค์กร, เวลาเริ่ม) แล้วกรอง end ในหน่วยความจำ
  /// — MySQL ใช้ index ได้แค่คอลัมน์เดียวของช่วง จึงเลือกอันที่คัดทิ้งได้มากกว่า
  @@index([tenantId, plannedStart])
  @@map("change_window")
}

/// ช่วงห้ามเปลี่ยนแปลงระดับองค์กร
///
/// **ไม่มีสูตรคำนวณ** — ปิดงบสิ้นปี ช่วงสอบ ช่วงเทศกาล ล้วนมาจากการตกลงกัน
/// ของคน · ต้องกรอกเอง เหมือนวันหยุดตามประกาศ ครม. ใน `SlaCalendarYear`
model ChangeFreeze {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  name String @db.VarChar(120)
  /// ทำไมถึงห้าม — คนที่จะขอข้ามต้องอ่านแล้วตัดสินใจได้เอง
  reason String @db.VarChar(500)

  startsAt DateTime @map("starts_at") @db.DateTime(3)
  endsAt   DateTime @map("ends_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, startsAt])
  @@index([tenantId, startsAt])
  @@map("change_freeze")
}

model WorkItemSla {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  workItemId BigInt @map("work_item_id")
  goalId     BigInt @map("goal_id")

  state           String    @db.VarChar(16)
  elapsedMs       Int       @map("elapsed_ms")
  targetMs        Int       @map("target_ms")
  /// กำหนดที่จะหลุดในอนาคต — null เมื่อนาฬิกาพัก จบ หรือหลุดไปแล้ว
  breachAt        DateTime? @map("breach_at") @db.DateTime(3)
  /// เวลาที่หลุดไปแล้วจริง — null เมื่อยังไม่หลุด
  /// ต้องเก็บแยกจาก breachAt เพราะ breachAt เป็น null ทันทีที่หลุด
  /// ถ้าไม่มีค่านี้จะกู้การแจ้งเตือนที่ตกหล่นไม่ได้ และรายงานตอบไม่ได้ว่าช้าเท่าไร
  breachedAt      DateTime? @map("breached_at") @db.DateTime(3)
  isBreached      Boolean   @default(false) @map("is_breached")
  /// ปฏิทินของปีที่นาฬิกาเรือนนี้กำลังนับ ได้รับการยืนยันแล้วหรือยัง
  ///
  /// เก็บติดมากับค่า denormalise เพราะ worker อ่านตารางนี้ตรง ๆ และเรียกโค้ด
  /// ของ api ไม่ได้ · ค่าเริ่มต้นเป็น false เพราะ "ยังไม่รู้" ต้องแปลว่าเชื่อไม่ได้
  calendarTrusted Boolean   @default(false) @map("calendar_trusted")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workItem WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  goal     SlaGoal    @relation(fields: [goalId], references: [id], onDelete: Restrict)
  events   SlaEvent[]

  @@unique([workItemId, goalId])
  // คิว "ใกล้หลุด" เรียงตาม breachAt ของงานที่ยังเดินอยู่
  @@index([tenantId, isBreached, breachAt])
  // ตัวกวาดหาการแจ้งเตือนที่ตกหล่น ค้นด้วย (state, breachedAt)
  @@index([state, breachedAt])
  @@index([tenantId, workItemId])
  @@map("work_item_sla")
}

/**
 * append-only — แหล่งความจริงของนาฬิกา SLA
 */
model SlaEvent {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt   @map("tenant_id")
  workItemSlaId BigInt   @map("work_item_sla_id")
  kind          String   @db.VarChar(16)
  at            DateTime @db.DateTime(3)
  newTargetMs   Int?     @map("new_target_ms")

  sla WorkItemSla @relation(fields: [workItemSlaId], references: [id], onDelete: Cascade)

  @@index([tenantId, workItemSlaId, at])
  @@map("sla_event")
}

/**
 * การแจ้งเตือน — เก็บลงฐานข้อมูลก่อนส่งออกช่องทางใด ๆ
 * ทำไมต้องเก็บ ไม่ยิงตรงไป LINE/อีเมล:
 * 1. ส่งซ้ำได้เมื่อช่องทางล่ม โดยไม่ต้องคำนวณ SLA ใหม่
 * 2. ผู้ใช้เห็นย้อนหลังได้ในแอป แม้ไม่ได้เปิดอีเมล
 * 3. ตรวจสอบได้ว่าระบบเตือนแล้วจริงหรือไม่ ตอนมีข้อพิพาทเรื่อง SLA
 */
model Notification {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt    @map("tenant_id")
  /// ผู้รับ — null เมื่อเป็นการแจ้งเตือนระดับทีมที่ยังไม่ระบุตัวบุคคล
  userId          BigInt?   @map("user_id")
  workItemId      BigInt?   @map("work_item_id")
  /// e.g. "sla.threshold" · "workitem.assigned"
  kind            String    @db.VarChar(64)
  title           String    @db.VarChar(500)
  body            String?   @db.Text
  payload         Json?
  /// กันส่งซ้ำ — เหตุการณ์เดียวกันสร้างคีย์เดียวกันเสมอ
  dedupeKey       String    @map("dedupe_key") @db.VarChar(191)
  /// ผู้รับปิดอีเมลของชนิดนี้ไว้ — ตัดสินตอนสร้างแถว ไม่ใช่ตอนจะส่ง
  ///
  /// worker เรียกโค้ดของ api ไม่ได้ (คนละ workspace คนละโปรเซส) การคำนวณ
  /// นโยบายซ้ำที่นั่นคือการมีสองความจริง · คำตอบจึงเดินทางมากับแถว
  /// เหมือนที่ `work_item_sla` ทำกับสถานะ SLA
  emailSuppressed Boolean   @default(false) @map("email_suppressed")
  readAt          DateTime? @map("read_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  deliveries NotificationDelivery[]
  /*
    **ต้องมี foreign key ทั้งสามทาง** — เดิมตารางนี้ไม่มี FK เลยสักตัว
    ลบผู้ใช้หรือลบงานแล้วแถวแจ้งเตือนค้างอยู่เงียบ ๆ โดยไม่มี error สักบรรทัด
    วัดจริงในฐานข้อมูลพัฒนา: 170 แถวชี้ไปหาผู้ใช้ที่ถูกลบไปแล้ว สะสมจากเทสต์
    ที่สร้างผู้ใช้แล้วลบ · ไม่มีใครเห็นเพราะทุกคิวรีกรองด้วย userId ของคนที่
    ล็อกอินอยู่ แถวกำพร้าจึงไม่โผล่ที่ไหนเลย
  */
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, userId, readAt])
  @@index([tenantId, workItemId])
  @@map("notification")
}

/**
 * การส่งออกช่องทางหนึ่ง ๆ ของการแจ้งเตือนหนึ่งใบ
 * แยกตารางเพราะการแจ้งเตือนหนึ่งใบไปได้หลายช่องทาง และแต่ละช่องทาง
 * สำเร็จหรือล้มเหลวคนละเวลา ถ้าเก็บสถานะไว้ในแถวเดียวกับ notification
 * การที่อีเมลล้มจะทำให้ไม่รู้ว่า LINE ส่งไปแล้วหรือยัง
 * **แถวนี้ถูกสร้างก่อนส่งเสมอ** — ถ้าสร้างหลังส่ง เครื่องดับกลางทาง
 * จะทำให้ส่งซ้ำทุกรอบโดยไม่มีอะไรจำได้ว่าเคยพยายามแล้ว
 * unique index บน (notificationId, channel) เป็นด่านสุดท้ายกันส่งซ้ำ
 */
model NotificationDelivery {
  id             BigInt @id @default(autoincrement())
  tenantId       BigInt @map("tenant_id")
  notificationId BigInt @map("notification_id")

  /// "email" · "line" · "webhook"
  channel String  @db.VarChar(16)
  /// "pending" | "sent" | "failed" | "skipped"
  state   String  @db.VarChar(16)
  /// ปลายทางที่ส่งไปจริง — เก็บไว้เพราะอีเมลของผู้ใช้เปลี่ยนได้ภายหลัง
  /// ถ้าไม่เก็บ จะตอบไม่ได้ว่าตอนนั้นส่งไปที่ไหน
  target  String? @db.VarChar(320)

  attempts  Int       @default(0)
  /// เหตุผลที่ล้ม หรือเหตุผลที่ข้าม — ต้องอ่านเข้าใจได้โดยไม่ต้องเปิด log
  lastError String?   @map("last_error") @db.VarChar(500)
  sentAt    DateTime? @map("sent_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  // ตัวกวาดหาที่ยังไม่ได้ส่ง ค้นด้วย (tenant, ช่องทาง, สถานะ)
  @@index([tenantId, channel, state])
  @@map("notification_delivery")
}

// ============================================================
// Service Catalog
//
// ผู้แจ้งเลือก "บริการ" ที่เข้าใจได้ แทนการพิมพ์อิสระแล้วให้ทีมมาเดาทีหลังว่า
// เรื่องนี้คืออะไร · หมวดหมู่ที่ไม่ได้เก็บตั้งแต่วันแรก ย้อนกลับไปใส่ทีหลังไม่ได้
// ============================================================

model CatalogCategory {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(128)
  /// ลำดับที่แสดง — ตัวเลขน้อยขึ้นก่อน · ไม่ใช้ชื่อเรียงเพราะภาษาไทยเรียงตามพจนานุกรมไม่ตรงกับที่คนคาด
  sortOrder Int      @default(100) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CatalogItem[]

  @@unique([tenantId, name])
  @@map("catalog_category")
}

model CatalogItem {
  id          BigInt  @id @default(autoincrement())
  tenantId    BigInt  @map("tenant_id")
  categoryId  BigInt  @map("category_id")
  /// ชื่อที่ผู้แจ้งอ่านแล้วรู้ว่าใช่ — ภาษาคน ไม่ใช่ศัพท์ระบบ (CLAUDE.md §5)
  name        String  @db.VarChar(200)
  /// อธิบายว่าใช้ตอนไหน — ช่วยให้เลือกถูกโดยไม่ต้องเดา
  description String? @db.Text

  /// เรื่องที่แจ้งผ่านรายการนี้ จะไปลงที่โปรเจกต์และประเภทงานนี้
  projectId   BigInt @map("project_id")
  issueTypeId BigInt @map("issue_type_id")
  /// ความสำคัญตั้งต้น — null = ให้ระบบตัดสินตามปกติ
  priorityId  Int?   @map("priority_id")

  sortOrder Int      @default(100) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  issueType IssueType       @relation(fields: [issueTypeId], references: [id], onDelete: Restrict)
  priority  Priority?       @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  workItems WorkItem[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, sortOrder])
  @@map("catalog_item")
}

// ============================================================
// CSAT — ความพอใจของผู้แจ้ง
//
// **ถามได้ครั้งเดียวคือตอนเพิ่งปิด** — ความรู้สึกต่อเรื่องที่ปิดไปสามเดือนแล้ว
// ย้อนกลับไปถามไม่ได้ · ไม่เก็บตั้งแต่วันแรกคือไม่มีวันได้
// ============================================================

model Satisfaction {
  id           BigInt @id @default(autoincrement())
  tenantId     BigInt @map("tenant_id")
  /// หนึ่งเรื่องหนึ่งคำตอบ — ไม่ใช่ประวัติการให้คะแนน
  workItemId   BigInt @unique @map("work_item_id")
  /// คนที่ตอบ · เก็บไว้เพื่อยืนยันว่าเป็นผู้แจ้งจริง ไม่ใช่คนทำงานให้คะแนนตัวเอง
  respondentId BigInt @map("respondent_id")

  /// 1–5 · ตรวจในโค้ด ไม่ใช่ใน enum เพราะเกณฑ์อาจเปลี่ยนโดยไม่ต้อง migrate
  rating  Int
  comment String? @db.Text

  /**
   * เวลาที่เรื่องถูกปิด **ตอนที่ให้คะแนน**
   * ไม่ใช่ค่าที่อ่านจาก work_item ตอนทำรายงาน — เรื่องที่ถูกเปิดใหม่ภายหลัง
   * จะมี resolvedAt เป็น null หรือเป็นเวลาใหม่ แล้วคะแนนเก่าจะลอยไม่มีที่อ้างอิง
   */
  resolvedAt DateTime @map("resolved_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  respondent User     @relation(fields: [respondentId], references: [id], onDelete: Restrict)

  @@index([tenantId, rating, createdAt])
  @@map("satisfaction")
}

// ============================================================
// การอนุมัติขั้นเดียว
//
// **เก็บเป็นประวัติ ไม่ใช่แถวเดียวที่ถูกเขียนทับ** — คำขอที่ถูกปฏิเสธแล้วขอใหม่
// ต้องตอบได้ว่าเคยถูกปฏิเสธเพราะอะไร · MySQL ไม่มี partial index จึงบังคับ
// "หนึ่งคำขอที่ค้างอยู่" ด้วยโค้ด ไม่ใช่ด้วย unique index (CLAUDE.md §3)
// ============================================================

enum ApprovalStatus {
  /// ยังไม่ถึงคิว — สร้างพร้อมกันทั้งสายตั้งแต่ต้น เพื่อให้ผู้ขอเห็นว่าเหลืออีกกี่ขั้น
  WAITING
  PENDING
  APPROVED
  REJECTED
  /// ถูกยกเลิกเพราะมีเหตุอื่น เช่น งานถูกปิดไปก่อน — ไม่ใช่การตัดสินใจของคน
  CANCELLED
}

model Approval {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  workItemId BigInt @map("work_item_id")

  /// กลุ่มที่อนุมัติได้ — ให้ผ่านกลุ่มเท่านั้น เพื่อตอบได้ว่า "อนุมัติได้เพราะอยู่กลุ่มไหน"
  approverGroupId BigInt  @map("approver_group_id")
  requestedById   BigInt  @map("requested_by_id")
  /// เหตุผลที่ขอ — ผู้อนุมัติต้องรู้ว่ากำลังอนุมัติอะไร ไม่ใช่เห็นแค่เลขที่เรื่อง
  reason          String? @db.Text

  /// รอบการขออนุมัติของเรื่องนี้ — ขอใหม่หลังถูกปฏิเสธได้ โดยรอบเก่ายังอ่านย้อนหลังได้
  chainSeq   Int @default(1) @map("chain_seq")
  /// ขั้นที่เท่าไรในรอบนี้ — **ลำดับมาจากเลขนี้ ไม่ใช่จาก `createdAt`**
  /// ทุกขั้นถูกสร้างในทรานแซกชันเดียวกัน เวลาจึงเท่ากันได้ทั้งสาย
  stepNumber Int @default(1) @map("step_number")

  status       ApprovalStatus @default(PENDING)
  decidedById  BigInt?        @map("decided_by_id")
  decidedAt    DateTime?      @map("decided_at") @db.DateTime(3)
  /// เหตุผลที่ปฏิเสธ — การปฏิเสธที่ไม่บอกเหตุผลคือทางตันของผู้ขอ
  decisionNote String?        @map("decision_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem      WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  approverGroup UserGroup @relation(fields: [approverGroupId], references: [id], onDelete: Restrict)
  requestedBy   User      @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy     User?     @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  /// หนึ่งขั้นต่อหนึ่งรอบเท่านั้น — ด่านสุดท้ายที่กันการสร้างสายซ้อนกันสองสาย
  @@unique([tenantId, workItemId, chainSeq, stepNumber])
  @@index([tenantId, workItemId, chainSeq, stepNumber])
  @@index([tenantId, status, createdAt])
  @@map("approval")
}

/**
 * บทความคลังความรู้
 * ขอบเขตตั้งแต่ต้น: **ผูกกับตั๋วเท่านั้น ไม่ใช่ระบบเอกสารทั่วไป**
 * (docs/jira-parity-checklist.md — Confluence-class wiki ถูกตัดออกโดยตั้งใจ)
 * คุณค่าที่แท้จริงคือคำตอบที่ทีมตอบซ้ำทุกสัปดาห์ ย้ายมาอยู่ที่เดียว
 * แล้วแนบเข้าตั๋วได้ — ไม่ใช่การมีที่เก็บเอกสารอีกที่หนึ่ง
 */
model KnowledgeArticle {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  title    String @db.VarChar(500)
  /// structured document แบบเดียวกับ description และ comment
  body     Json
  authorId BigInt @map("author_id")

  /// ยังไม่เผยแพร่ = เห็นเฉพาะทีม · เผยแพร่แล้ว = ผู้แจ้งเห็นได้ด้วย
  ///
  /// แยกจากการลบ เพราะบทความที่เขียนค้างไว้ครึ่งทางไม่ควรไปโผล่ให้ลูกค้าอ่าน
  /// และไม่ควรหายไปจากคนเขียนด้วย
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  /// soft delete — ตั๋วที่เคยแนบบทความนี้ต้องยังตอบได้ว่าเคยแนบอะไร
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  links  WorkItemArticle[]

  @@index([tenantId, isPublished, updatedAt])
  @@map("knowledge_article")
}

/**
 * บทความที่แนบกับตั๋ว
 * `helpful` บันทึกว่าบทความนี้ช่วยแก้เรื่องนั้นได้จริงไหม — เป็นข้อมูลเดียว
 * ที่บอกได้ว่าบทความไหนคุ้มค่าที่จะดูแลต่อ และบทความไหนเขียนไว้แล้วไม่มีใครใช้
 */
model WorkItemArticle {
  workItemId BigInt   @map("work_item_id")
  articleId  BigInt   @map("article_id")
  tenantId   BigInt   @map("tenant_id")
  addedById  BigInt   @map("added_by_id")
  /// null = ยังไม่มีใครบอก · ต่างจาก false ที่แปลว่าลองแล้วไม่ช่วย
  helpful    Boolean? @map("helpful")
  addedAt    DateTime @default(now()) @map("added_at") @db.DateTime(3)

  workItem WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  article  KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  addedBy  User             @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@id([workItemId, articleId])
  @@index([tenantId, articleId])
  @@map("work_item_article")
}

// ============================================================
// Automation
// ============================================================

/// กฎอัตโนมัติ — Trigger → Condition → Action
///
/// `conditions` และ `actions` เก็บเป็น JSON เพราะจำนวนข้อไม่คงที่และไม่มี
/// คิวรีไหนต้องค้นเข้าไปข้างใน — ตัวกรองเดียวที่ใช้จริงคือ trigger กับ isEnabled
/// ซึ่งเป็นคอลัมน์แยก · เอนจินตรวจรูปร่างของ JSON ก่อนใช้ทุกครั้ง
model AutomationRule {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  /// null = ทุกโปรเจกต์ในองค์กร · ระบุ = เฉพาะโปรเจกต์นั้น
  projectId BigInt? @map("project_id")
  name      String  @db.VarChar(128)
  /// ค่าตรงกับ TriggerKind ใน automation-engine.ts — เทสต์เทียบสองฝั่งให้
  trigger   String  @db.VarChar(32)
  /// **ปิดไว้เป็นค่าปริยาย** — กฎที่เพิ่งสร้างยังไม่มีใครอ่านทวน
  /// การเปิดเองทันทีแปลว่ากฎที่พิมพ์ผิดเริ่มแตะตั๋วจริงก่อนที่ใครจะเห็น
  isEnabled Boolean @default(false) @map("is_enabled")
  /// ลำดับที่กฎทำงาน — ผู้ดูแลจัดเอง เพราะกฎที่มอบหมายต้องมาก่อนกฎที่แจ้งเตือน
  sortOrder Int     @default(0) @map("sort_order")

  conditions  Json
  actions     Json
  createdById BigInt?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]

  @@unique([tenantId, name])
  @@index([tenantId, trigger, isEnabled, sortOrder])
  @@map("automation_rule")
}

/// สิ่งที่กฎทำจริง — หนึ่งแถวต่อหนึ่งการกระทำ
///
/// **บันทึกก่อนลงมือ ไม่ใช่หลังรู้ผล** (กติกาเดียวกับ notification_delivery)
/// เครื่องที่ดับกลางทางต้องทิ้งร่องรอยว่าเคยตั้งใจทำอะไร ไม่ใช่เงียบไป
///
/// เก็บ `ruleName` ซ้ำไว้ด้วยเหตุผลเดียวกับ `audit_log.actorName` — ลบกฎแล้ว
/// ประวัติต้องยังตอบได้ว่า "กฎชื่ออะไรสั่ง" ไม่ใช่กลายเป็นช่องว่าง
///
/// **สิ่งที่ *ไม่* ทำ ก็ต้องบันทึก** — แถว skipped/failed คือคำตอบเดียวของคำถาม
/// "ทำไมกฎไม่ทำงาน" ซึ่งเป็นคำถามที่ผู้ดูแลถามบ่อยกว่าคำถามตรงข้าม
model AutomationRun {
  id         BigInt  @id @default(autoincrement())
  tenantId   BigInt  @map("tenant_id")
  ruleId     BigInt? @map("rule_id")
  ruleName   String  @map("rule_name") @db.VarChar(128)
  workItemId BigInt? @map("work_item_id")
  trigger    String  @db.VarChar(32)

  actionKind  String  @map("action_kind") @db.VarChar(32)
  actionValue String  @map("action_value") @db.Text
  /// pending | applied | skipped | failed — `pending` คือแถวที่จองไว้ก่อนลงมือ
  outcome     String  @db.VarChar(16)
  /// เหตุผลที่ข้ามหรือที่ล้ม — ว่างได้เฉพาะเมื่อ applied
  reason      String? @db.Text
  /// ตรงกับ work_item_history.trace_id ของรอบนั้น — join กลับไปดูผลจริงได้
  traceId     String  @map("trace_id") @db.VarChar(64)
  depth       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule     AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  workItem WorkItem?       @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, workItemId, createdAt])
  @@index([tenantId, ruleId, createdAt])
  @@index([tenantId, traceId])
  @@map("automation_run")
}

// ============================================================
// การแจ้งเตือน — ใครได้รับอะไร
// ============================================================

/// สวิตช์ของผู้ดูแล — ปิดการแจ้งเตือนชนิดหนึ่งทั้งองค์กร หรือเฉพาะโปรเจกต์
///
/// **ไม่มีแถว = เปิด** ไม่ใช่ปิด · กลับทางกับกติกาสิทธิ์โดยตั้งใจ เพราะ
/// การไม่ส่งเงียบ ๆ ไม่มีอะไรฟ้อง ส่วนการส่งเกินมีคนมาบ่นแล้วได้แก้
/// (เหตุผลเต็มอยู่ที่หัวไฟล์ notification-policy.ts)
model NotificationRule {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  /// null = ทุกโปรเจกต์ · ระบุ = เฉพาะโปรเจกต์นั้น และชนะสวิตช์รวมเสมอ
  projectId BigInt? @map("project_id")
  /// ค่าตรงกับ NOTIFICATION_KINDS ใน notification-policy.ts — เทสต์เทียบสองฝั่ง
  kind      String  @db.VarChar(64)
  isEnabled Boolean @default(true) @map("is_enabled")

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// หนึ่งความหมายเก็บแถวเดียว — สวิตช์ซ้ำสองแถวที่ค่าต่างกัน ตอบไม่ได้ว่าอันไหนจริง
  @@unique([tenantId, projectId, kind])
  @@index([tenantId, kind])
  @@map("notification_rule")
}

/// สิ่งที่ผู้ใช้คนหนึ่งเลือกเอง — ปิดได้ทีละช่องทาง
///
/// เก็บเฉพาะแถวที่ **ต่างจากค่าปริยาย** · การเขียนแถว `isEnabled: true` ให้ทุกคน
/// ทุกชนิดตอนสร้างบัญชี จะทำให้การเพิ่มชนิดใหม่ต้องไล่เขียนย้อนหลังทุกคน
/// และคนที่เพิ่งเข้ามาจะไม่ได้รับชนิดใหม่จนกว่าจะมีใครไปเขียนให้
model NotificationPreference {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  userId   BigInt @map("user_id")
  kind     String @db.VarChar(64)
  /// "in-app" | "email"
  channel  String @db.VarChar(16)

  isEnabled Boolean  @default(true) @map("is_enabled")
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, channel])
  @@index([tenantId, userId])
  @@map("notification_preference")
}

// ============================================================
// บันทึกเวลาทำงาน
// ============================================================

/// เวลาที่คนหนึ่งใช้ไปกับงานหนึ่ง ครั้งหนึ่ง
///
/// **`startedAt` คือเวลาที่ทำงาน ไม่ใช่เวลาที่บันทึก** — คนบันทึกงานของวันศุกร์
/// ในเช้าวันจันทร์เป็นเรื่องปกติ · รายงานที่ใช้ `createdAt` จะทำให้ทุกสัปดาห์
/// ผิดโดยไม่มีอะไรฟ้อง และผิดไปทางที่ดูสมเหตุสมผลด้วย
model WorkLog {
  id         BigInt @id @default(autoincrement())
  tenantId   BigInt @map("tenant_id")
  workItemId BigInt @map("work_item_id")
  /// คนที่ทำงาน — ไม่ใช่คนที่กดบันทึก (วันหน้าอาจให้หัวหน้าบันทึกแทนได้)
  userId     BigInt @map("user_id")

  spentMinutes Int      @map("spent_minutes")
  /// เวลาที่ **ลงมือทำ** — ดูหัว model
  startedAt    DateTime @map("started_at") @db.DateTime(3)
  note         String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// รายงาน "ใครใช้เวลาไปกับอะไรช่วงไหน" อ่านด้วยดัชนีนี้
  @@index([tenantId, userId, startedAt])
  @@index([tenantId, workItemId, startedAt])
  @@map("work_log")
}

// ============================================================
// อีเมลขาเข้า
// ============================================================

/// จดหมายทุกฉบับที่ระบบอ่านมาจากกล่อง — **รวมฉบับที่ถูกปฏิเสธ**
///
/// จดหมายที่ถูกทิ้งเงียบ ๆ คือคำขอที่ไม่มีใครรู้ว่าเคยมี · คนที่ส่งมาแล้ว
/// ไม่มีใครตอบ จะสรุปว่า "ส่งเมลไปแล้วไม่มีใครสนใจ" ซึ่งเสียหายกว่าการ
/// เก็บแถวที่ไม่ได้ใช้ไว้มาก
///
/// `mailboxId` เป็น unique — **กันอ่านซ้ำที่ชั้นฐานข้อมูล ไม่ใช่ที่ตัวอ่าน**
/// ตัวอ่านที่จำว่าอ่านถึงไหนแล้วในหน่วยความจำ จะเริ่มนับใหม่ทุกครั้งที่รีสตาร์ต
/// แล้วสร้างตั๋วซ้ำทั้งกล่อง
model InboundMail {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  /// รหัสของจดหมายในกล่อง — คีย์กันอ่านซ้ำ
  mailboxId String  @map("mailbox_id") @db.VarChar(191)
  /// `Message-ID` ของจดหมาย — ใช้ผูกจดหมายฉบับถัดไปกลับเข้าเรื่องเดิม
  messageId String? @map("message_id") @db.VarChar(500)

  fromAddress String  @map("from_address") @db.VarChar(320)
  subject     String  @db.VarChar(1000)
  /// created | commented | rejected
  outcome     String  @db.VarChar(16)
  /// เหตุผลที่ปฏิเสธ — ว่างได้เฉพาะเมื่อสำเร็จ
  reason      String? @db.Text

  workItemId BigInt?  @map("work_item_id")
  receivedAt DateTime @map("received_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@unique([tenantId, mailboxId])
  /// หา "เรื่องเดิม" จาก In-Reply-To ด้วยดัชนีนี้
  @@index([tenantId, messageId])
  @@index([tenantId, outcome, createdAt])
  @@map("inbound_mail")
}
