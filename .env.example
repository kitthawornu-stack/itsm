# ---------------------------------------------------------------
# ไฟล์นี้คือสิ่งที่ตัดสินว่า "ติดตั้งใหม่แล้วใช้ได้ไหม"
#
# เคยล้าหลังไปทั้งรุ่น: ใช้พอร์ตชุดเก่าทั้งหมด (3307 · 6379 · 9200 · 9000 ·
# 4000) ทั้งที่ §9 ย้ายไป 4xxx แล้ว และ **ขาดตัวแปรที่โค้ดอ่านจริงไป 22 ตัว**
# — รวม `API_INTERNAL_URL` กับ `CORS_ORIGINS` ซึ่งเป็นสองในห้าสาเหตุที่ทำให้
# การยกสแตกจริงครั้งแรกใช้ไม่ได้ทั้งที่ build ผ่านหมด
#
# `env-example.spec.ts` สแกนซอร์ส · docker-compose · schema.prisma
# แล้วบังคับว่าทุกตัวที่มีคนอ่าน ต้องอยู่ในไฟล์นี้ และทุกตัวในไฟล์นี้
# ต้องมีคนอ่าน — ค่าที่ตั้งแล้วไม่มีผล ทำให้คนเชื่อว่าตั้งค่าเรียบร้อยแล้ว
#
# **โฮสต์ของบริการใน Docker ใช้ `127.0.0.1` ไม่ใช่ `localhost`**
# บนวินโดวส์ `localhost` แปลเป็น IPv6 `::1` ก่อน แล้วไปเจอ proxy ค้างของ WSL
# ผลคือต่อไม่ติดเป็นบางครั้งโดยไม่มี error ที่อ่านออก
# ---------------------------------------------------------------

# ---------- Database (MySQL 8) ----------
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=itsm_root_dev
MYSQL_DATABASE=itsm
MYSQL_USER=itsm
MYSQL_PASSWORD=itsm_dev
MYSQL_PORT=4306
MYSQL_HOST=127.0.0.1
# ชื่อคอนเทนเนอร์ MySQL — สคริปต์ที่ต้องรัน mysql ผ่าน docker exec ใช้ค่านี้
MYSQL_CONTAINER=itsm-mysql
DATABASE_URL="mysql://itsm:itsm_dev@127.0.0.1:4306/itsm"

# ---------- Redis / BullMQ ----------
REDIS_PORT=4379
REDIS_URL="redis://127.0.0.1:4379"

# ---------- OpenSearch ----------
OPENSEARCH_PORT=4200
OPENSEARCH_URL="http://127.0.0.1:4200"
OPENSEARCH_INDEX_PREFIX=itsm

# ---------- Object storage (MinIO, S3-compatible) ----------
MINIO_ROOT_USER=itsm
MINIO_ROOT_PASSWORD=itsm_dev_secret
MINIO_PORT=4900
MINIO_CONSOLE_PORT=4901
S3_ENDPOINT="http://127.0.0.1:4900"
S3_BUCKET=itsm-attachments
S3_REGION=ap-southeast-1

# ---------- Mail (Mailpit ในโหมดพัฒนา ดักทุกฉบับไว้) ----------
MAILPIT_SMTP_PORT=4025
MAILPIT_UI_PORT=4825
SMTP_HOST=127.0.0.1
SMTP_PORT=4025
# พอร์ต SMTP **ในคอนเทนเนอร์** ที่ compose ใช้ — ไม่ใช่พอร์ตที่ map ออกมา
SMTP_PORT_INTERNAL=1025
SMTP_SECURE=false
# Mailpit ไม่ต้องยืนยันตัวตน · ของจริงต้องกรอก
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Helix Service Desk <no-reply@itsm.local>"

# ---------- อีเมลขาเข้า (Email-to-Ticket) ----------
# ปิดเป็นค่าปริยายโดยตั้งใจ — อีเมลขาเข้าสร้างข้อมูลจริงจากสิ่งที่ระบบไม่ได้ควบคุม
# การเปิดเองแปลว่าใครก็ตามที่รู้ที่อยู่กล่อง สร้างตั๋วได้ตั้งแต่วินาทีที่ติดตั้งเสร็จ
#
# ตอนบูต ระบบเขียน log เสมอว่าเปิดหรือปิด และถ้าปิดเพราะอะไร — ความเงียบตรงนี้
# แปลว่าคำขอของคนหายไปทุกฉบับโดยไม่มีใครรู้
MAIL_INTAKE=off
# ตอนนี้มีแต่ mailpit · IMAP ยังไม่ได้เขียน (ดู IMAP_TODO ใน mail-source.ts)
MAIL_INTAKE_SOURCE=mailpit
MAIL_INTAKE_URL=http://127.0.0.1:4825
# โปรเจกต์และประเภทงานที่ตั๋วจากอีเมลจะไปอยู่ — ไม่ตั้ง = ไม่เปิด
MAIL_INTAKE_PROJECT=
MAIL_INTAKE_ISSUE_TYPE=
# รอบอ่านกล่อง · ต่ำกว่า 30 วินาทีถือว่าพิมพ์ผิด และใช้ค่าปริยาย 5 นาทีแทน
MAIL_INTAKE_INTERVAL_MS=300000

# ---------- งานเบื้องหลัง ----------
# `SCHEDULERS=off` ปิดตัวตั้งเวลา **ทุกตัว** พร้อมกัน — ใช้ตอนรันเทสต์ที่ยกแอป
# ขึ้นทั้งตัว มิฉะนั้นตัวตั้งเวลาจะแตะฐานข้อมูลเดียวกับที่ไฟล์เทสต์อื่นกำลังใช้
# **ค่าปริยายคือเปิด** เพราะสวิตช์ที่ปิดโดยปริยายจะทำให้ production เงียบสนิท
# ในวันที่ลืมตั้ง
SCHEDULERS=on
AUTOMATION_SCAN=on
INDEX_WATCH=on
SLA_RECONCILE_INTERVAL_MS=300000
EMAIL_DELIVERY_INTERVAL_MS=60000
REPORT_SEND_INTERVAL_MS=300000

# ---------- App ----------
NODE_ENV=development
API_PORT=4400
WEB_PORT=4300
# **สองตัวนี้มีความหมายต่างกัน และเหมือนกันเฉพาะบนเครื่องพัฒนา**
# `API_BASE_URL` = ที่อยู่ที่ **เบราว์เซอร์** เรียก (จึงเป็น localhost ได้)
# `API_INTERNAL_URL` = ที่อยู่ที่ **server component ของ web** เรียก
# ในคอนเทนเนอร์ `localhost` ของ web คือตัว web เอง — ตั้งผิดแล้วจะล็อกอินได้
# หน้าจัดการผู้ใช้ทำงาน แต่หน้าคิวกับหน้าแจ้งปัญหาว่างเปล่าโดยไม่มี error ที่ไหนเลย
API_BASE_URL="http://localhost:4400"
API_INTERNAL_URL="http://127.0.0.1:4400"
WEB_BASE_URL="http://localhost:4300"
# ต้นทางที่เบราว์เซอร์ใช้ · **ต้องตั้งบน production** เพราะชุดที่ส่งมอบเปิดคนละ
# พอร์ตโดยไม่มี reverse proxy — ไม่ตั้งแล้วเบราว์เซอร์บล็อกการล็อกอินทันที
CORS_ORIGINS="http://localhost:4300"

# ---------- Tenancy ----------
DEFAULT_TENANT_KEY=default

# ---------- ผู้ใช้คนแรก (ครั้งเดียวตอนติดตั้ง) ----------
# ฐานข้อมูลใหม่ไม่มีผู้ใช้เลย และไม่มีทางสร้างคนแรกผ่านหน้าจอ
# ดูวิธีรันใน CLAUDE.md §10 · รหัสผ่านส่งตอนรัน ไม่เก็บไว้ในไฟล์นี้
BOOTSTRAP_TENANT_NAME="องค์กรของฉัน"
BOOTSTRAP_ADMIN_NAME="ผู้ดูแลระบบ"

# ---------- production เท่านั้น (compose ของ on-prem อ้างถึง) ----------
PUBLIC_API_URL="http://helix.example.co.th:4400"
PUBLIC_WEB_URL="http://helix.example.co.th:4300"

# ---------- สคริปต์วัดโหลด ----------
LOADTEST_API="http://127.0.0.1:4400"
LOADTEST_EMAIL=agent1@example.co.th
LOADTEST_PASSWORD=
LOADTEST_PROJECT=SD
