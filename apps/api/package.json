{
  "name": "@itsm/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"eslint: Phase 0 pending\"",
    "test": "dotenv -e ../../.env -- vitest run",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "start": "node dist/main.js",
    "reindex": "dotenv -e ../../.env -- tsx src/scripts/reindex.ts",
    "seed:sla": "dotenv -e ../../.env -- tsx src/scripts/seed-sla.ts",
    "recompute-sla": "dotenv -e ../../.env -- tsx src/scripts/recompute-sla.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^7.4.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@itsm/hql": "workspace:*",
    "@itsm/lexorank": "workspace:*",
    "@itsm/types": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  }
}
